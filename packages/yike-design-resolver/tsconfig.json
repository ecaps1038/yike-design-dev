{
  "compilerOptions": {
    "rootDir": "src",
    "sourceMap": true,
    "outDir": "dist",
    "module": "CommonJS",
    "target": "ES2015",
    "allowJs": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"],
    "declaration": true,
//    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}